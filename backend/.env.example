# ── Runtime ───────────────────────────────────────────
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false

# ── Database ──────────────────────────────────────────
# Leave empty in development to run on the built-in in-memory database (auto-seeded demo data).
MONGODB_URL=
MONGODB_DB=neuro_shield

# ── Auth (production refuses to start without a strong key) ──
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Cross-site deploys (e.g. Vercel frontend + Render API) need: COOKIE_SAMESITE=none
COOKIE_SAMESITE=lax

# ── HTTP ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=*
RATE_LIMIT_STORAGE_URI=memory://
# Cloudflare proxy: same secret as the Pages project; true = reject API traffic that bypassed Cloudflare
PROXY_SHARED_SECRET=
REQUIRE_PROXY_SECRET=false
# Keep MongoDB Atlas active (seconds between heartbeat pings)
DB_HEARTBEAT_SECONDS=240   # use redis://host:6379 when running multiple instances

# ── AI (optional - every feature has a deterministic fallback) ──
# auto = first configured of Groq -> Grok -> Gemini; the others become automatic fallbacks
LLM_PROVIDER=auto
GROQ_API_KEY=                    # https://console.groq.com/keys (free tier, starts with gsk_)
GROQ_MODEL=openai/gpt-oss-120b   # free developer-plan model with JSON-schema output
GROQ_REASONING_EFFORT=low
XAI_API_KEY=                     # optional: xAI Grok instead/as fallback
# Optional: Gemini is only needed for AI *video* review (Grok has no video input)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Movement analytics ────────────────────────────────
BASELINE_SESSIONS=5

# ── SOS SMS (optional) ────────────────────────────────
SOS_DEFAULT_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Demo accounts ─────────────────────────────────────
SEED_DEMO_DATA=false
DEMO_PASSWORD=
